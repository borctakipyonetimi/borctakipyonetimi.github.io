{
  "appId": "com.borctakip.app",
  "appName": "Bütçem Pro",
  "webDir": "dist",
  "plugins": {
    "CapacitorCookies": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#4F46E5"
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#020617",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#020617"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  }
}

