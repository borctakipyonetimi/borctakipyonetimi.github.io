{
  "appId": "com.borctakip.app",
  "appName": "BorcTakip",
  "webDir": "dist",
  "cordova": {
    "preferences": {
      "InAppBrowserStatusbarOverlaysWebView": "true"
    }
  },
  "server": {
    "url": "https://borctakipyonetimi.github.io",
    "cleartext": true,
    "allowNavigation": [
      "*.google.com",
      "*.googleapis.com",
      "*.firebaseapp.com",
      "*.googleusercontent.com",
      "accounts.google.com"
    ]
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "res://icon",
      "iconColor": "#4F46E5"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
