<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:padding="12dp">

    <!-- Header: App Title & Quick Add Button -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_expense"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#6366F1"
            android:gravity="center"
            android:contentDescription="@string/widget_add_expense_desc" />
    </LinearLayout>

    <!-- Content: Net Bakiye & Bu Ayki Gider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Net Bakiye Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_net_balance_label"
            android:textColor="#9CA3AF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_net_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_zero_amount"
            android:textColor="#34D399"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Bu Ayki Gider Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_monthly_expense_label"
            android:textColor="#9CA3AF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_monthly_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_zero_amount"
            android:textColor="#F87171"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>

