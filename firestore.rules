rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && userId == request.auth.token.email) ||
        (request.auth.token.email != null && userId == ('email_' + request.auth.token.email.replace('[^a-zA-Z0-9_]', '_'))) ||
        (resource != null && resource.data.email == request.auth.token.email) ||
        (resource != null && resource.data.userUid == request.auth.uid) ||
        (request.resource != null && request.resource.data.email == request.auth.token.email)
      );
    }

    // Secure users workspace doc for the authenticated owner
    match /users/{userId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && resource != null && resource.data.email == request.auth.token.email) ||
        (request.auth.token.email != null && request.resource != null && request.resource.data.email == request.auth.token.email) ||
        (resource != null && resource.data.userUid == request.auth.uid) ||
        (request.auth.token.email != null && userId.matches('^email_.*'))
      );
    }

    // Secure temporary APK sync sessions
    match /apk_sync_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Automated Mail Queue for APK & web email dispatch
    match /mail_queue/{mailId} {
      allow read, write: if true;
    }

    // Email subscribers registration for scheduled daily alerts
    match /email_subscribers/{subscriberId} {
      allow read, write: if true;
    }
  }
}
