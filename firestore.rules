rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Secure kullanicilar collection for authenticated owner
    match /kullanicilar/{userId} {
      allow read, write: if isSignedIn();

      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Secure users workspace doc and subcollections
    match /users/{userId} {
      allow read, write: if isSignedIn();

      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Secure temporary APK sync sessions
    match /apk_sync_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Automated Mail Queue for APK & web email dispatch
    match /mail_queue/{mailId} {
      allow read, write: if true;
    }

    // Email subscribers registration for scheduled daily alerts
    match /email_subscribers/{subscriberId} {
      allow read, write: if true;
    }
  }
}
